## Copy to slurm/site.env and edit. Sourced by slurm/common.sh.

## Module that gives compute nodes internet access; empty when not needed.
PROXY_MODULE=

## Used when snakemake is not on PATH at submission.
CONDA_INIT=/path/to/miniforge3/bin/activate
CONDA_ENV=/path/to/envs/snakemake

## Conda environments and container images, on permanent storage.
CONDA_PREFIX_DIR=/path/to/rhapsodist-envs
APPTAINER_CACHEDIR=/path/to/rhapsodist-containers

## 07_other_workflows.sh
UNIVERSC_SANDBOX=/path/to/universc_sandbox
ZUMIS_DIR=/path/to/zUMIs

## 09_archive.sh copies reports, count objects and benchmarks here.
RESULTS_DIR=/path/to/rhapsodist-results
