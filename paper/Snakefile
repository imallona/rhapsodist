## Optional paper-materials Snakefile. Consumes RDS outputs produced by the
## main rhapsodist pipeline and writes manuscript-ready CSV and PDF artefacts
## under <working_dir>/paper/<sample>/ (or <working_dir>/paper/ for benchmark
## outputs shared across samples).
##
## Run it after the main pipeline has finished, with the same config:
##
##   snakemake -s paper/Snakefile \
##       --configfile configs/sim_config.yaml \
##       --use-conda --cores 4
##
## It does not depend on workflow/Snakefile and does not mutate any pipeline
## outputs. Nothing here is imported or required by the production pipeline.

import os.path as op

WD = config["working_dir"]
SAMPLES = [s["name"] for s in config.get("samples", [])]
ALIGNERS = config.get("aligners", ["starsolo", "kallisto", "alevin"])
HAS_SBG = bool(config.get("has_sbg", False)) or "sbg" in ALIGNERS
IS_SIM = bool(config.get("use_simulated", False))
N_EXP_CELLS = int(config.get("sim_n_cells", 0))

PAPER_DIR = op.join(workflow.basedir)
SCRIPT = op.join(PAPER_DIR, "assemble_paper_figures.R")
ENV = op.join(PAPER_DIR, "env.yaml")

aligners_arg = ",".join(ALIGNERS)
has_sbg_arg = "true" if HAS_SBG else "false"
MARKERS_FILE = config.get("biology_markers_file", "")
BENCH_PREFIX = config.get("bench_prefix", "fig_sim")
USE_CASE = config.get("use_case", "sendoel")
_USE_CASE_FIG_STEMS = {"hela": "fig2_hela", "sendoel": "fig3_sendoel"}
if USE_CASE not in _USE_CASE_FIG_STEMS:
    raise ValueError(
        "use_case must be one of %s, got %r"
        % (sorted(_USE_CASE_FIG_STEMS), USE_CASE))
EXPERIMENTAL_FIG_STEM = _USE_CASE_FIG_STEMS[USE_CASE]


def simulation_flag(sample):
    return op.join(WD, "paper", sample, "sim_cell_counts.csv")


def experimental_flag(sample):
    return op.join(WD, "paper", sample, EXPERIMENTAL_FIG_STEM + ".pdf")


def linker_qc_flag(sample):
    return op.join(WD, "paper", sample, "bio_linker_errors.pdf")


def benchmark_flag():
    return op.join(WD, "paper", "bench_full.csv")


def all_targets():
    targets = [benchmark_flag()]
    for s in SAMPLES:
        if IS_SIM:
            targets.append(simulation_flag(s))
        else:
            targets.append(experimental_flag(s))
            targets.append(linker_qc_flag(s))
    return targets


rule all:
    input:
        all_targets()


rule simulations_figure:
    conda:
        ENV
    input:
        sces = expand(op.join(WD, "{aligner}", "{{sample}}",
                              "{{sample}}_{aligner}_sce.rds"),
                      aligner = ALIGNERS),
        script = SCRIPT,
        helpers = op.join(PAPER_DIR, "export_helpers.R"),
        agreement = op.join(PAPER_DIR, "..", "workflow", "src", "agreement_metrics.R"),
    output:
        op.join(WD, "paper", "{sample}", "sim_cell_counts.csv"),
        op.join(WD, "paper", "{sample}", "fig1_simulations_panels.pdf")
    params:
        wd = WD,
        aligners = aligners_arg,
        has_sbg = has_sbg_arg,
        n_exp = N_EXP_CELLS,
    log:
        op.join(WD, "logs", "paper_simulation_{sample}.log")
    shell:
        """
        Rscript {input.script} \
            --kind simulation \
            --working_dir {params.wd} \
            --sample {wildcards.sample} \
            --aligners {params.aligners} \
            --has_sbg {params.has_sbg} \
            --n_expected_cells {params.n_exp} &> {log}
        """


rule experimental_figure:
    conda:
        ENV
    input:
        biology_rds = op.join(WD, "{sample}_biology_qc.rds"),
        script = SCRIPT,
        helpers = op.join(PAPER_DIR, "export_helpers.R"),
        agreement = op.join(PAPER_DIR, "..", "workflow", "src", "agreement_metrics.R"),
    output:
        op.join(WD, "paper", "{sample}", "bio_qc.csv"),
        op.join(WD, "paper", "{sample}", EXPERIMENTAL_FIG_STEM + ".pdf")
    params:
        wd = WD,
        aligners = aligners_arg,
        has_sbg = has_sbg_arg,
        markers_file = MARKERS_FILE,
        use_case = USE_CASE,
    log:
        op.join(WD, "logs", "paper_experimental_{sample}.log")
    shell:
        """
        Rscript {input.script} \
            --kind biology \
            --working_dir {params.wd} \
            --sample {wildcards.sample} \
            --aligners {params.aligners} \
            --has_sbg {params.has_sbg} \
            --use_case {params.use_case} \
            --markers_file '{params.markers_file}' &> {log}
        """


rule linker_qc_figure:
    conda:
        ENV
    input:
        tsv = op.join(WD, "linker_qc", "{sample}_linker_errors.tsv"),
        script = SCRIPT,
        helpers = op.join(PAPER_DIR, "export_helpers.R"),
        agreement = op.join(PAPER_DIR, "..", "workflow", "src", "agreement_metrics.R"),
    output:
        op.join(WD, "paper", "{sample}", "bio_linker_errors.pdf"),
        op.join(WD, "paper", "{sample}", "bio_linker_errors.csv"),
    params:
        wd = WD,
    log:
        op.join(WD, "logs", "paper_linker_qc_{sample}.log")
    shell:
        """
        Rscript {input.script} \
            --kind linker_qc \
            --working_dir {params.wd} \
            --sample {wildcards.sample} &> {log}
        """


rule benchmarks_figure:
    conda:
        ENV
    input:
        script = SCRIPT,
        helpers = op.join(PAPER_DIR, "export_helpers.R"),
        agreement = op.join(PAPER_DIR, "..", "workflow", "src", "agreement_metrics.R"),
    output:
        op.join(WD, "paper", "bench_full.csv"),
        op.join(WD, "paper", BENCH_PREFIX + "_bench_total.pdf"),
        op.join(WD, "paper", BENCH_PREFIX + "_bench_step.pdf")
    params:
        wd = WD,
        aligners = aligners_arg,
        has_sbg = has_sbg_arg,
        n_exp = N_EXP_CELLS,
        bench_prefix = BENCH_PREFIX,
    log:
        op.join(WD, "logs", "paper_benchmarks.log")
    shell:
        """
        Rscript {input.script} \
            --kind benchmarks \
            --working_dir {params.wd} \
            --aligners {params.aligners} \
            --has_sbg {params.has_sbg} \
            --n_expected_cells {params.n_exp} \
            --bench_prefix {params.bench_prefix} &> {log}
        """


## UniverSC on the downsampled reads. Config: universc_sandbox (see README) and
## universc_technology (bd-rhapsody or bd-rhapsody-v2). Not part of rule all.
rule universc:
    input:
        r1 = op.join(WD, "data", "fastq", "downsampled", "{sample}_R1.fastq.gz"),
        r2 = op.join(WD, "data", "fastq", "downsampled", "{sample}_R2.fastq.gz"),
        genome = op.join(config.get("reference_dir", ""), "genome.fa"),
        gtf = op.join(config.get("reference_dir", ""), "annotation.gtf"),
        run = op.join(PAPER_DIR, "universc", "run_universc.sh"),
    output:
        outs = directory(op.join(WD, "universc", "{sample}", "work", "{sample}_outs")),
    params:
        sandbox = config.get("universc_sandbox", ""),
        technology = config.get("universc_technology", "bd-rhapsody"),
        workdir = op.join(WD, "universc", "{sample}", "work"),
        mem_gb = int(config.get("max_mem_mb", 48000) / 1000),
    threads:
        config.get("nthreads", 8)
    log:
        op.join(WD, "logs", "universc_{sample}.log")
    benchmark:
        op.join(WD, "benchmarks", "universc_{sample}.txt")
    shell:
        """
        bash {input.run} {params.sandbox} {params.workdir} {wildcards.sample} \
            {params.technology} {input.r1} {input.r2} {input.genome} {input.gtf} \
            {threads} {params.mem_gb} &> {log}
        """


rule universc_sce:
    conda:
        op.join(PAPER_DIR, "..", "workflow", "envs", "r_bioc.yaml")
    input:
        outs = op.join(WD, "universc", "{sample}", "work", "{sample}_outs"),
        script = op.join(PAPER_DIR, "universc", "universc_to_sce.R"),
    output:
        op.join(WD, "universc", "{sample}", "{sample}_universc_sce.rds")
    log:
        op.join(WD, "logs", "universc_sce_{sample}.log")
    shell:
        "Rscript {input.script} {input.outs} {wildcards.sample} {output} &> {log}"


## zUMIs on the downsampled reads of v1 beads. Config: zumis_dir, a clone of
## zUMIs 2.9.7 (see README). Not part of rule all.
rule zumis:
    input:
        r1 = op.join(WD, "data", "fastq", "downsampled", "{sample}_R1.fastq.gz"),
        r2 = op.join(WD, "data", "fastq", "downsampled", "{sample}_R2.fastq.gz"),
        genome = op.join(config.get("reference_dir", ""), "genome.fa"),
        gtf = op.join(config.get("reference_dir", ""), "annotation.gtf"),
        run = op.join(PAPER_DIR, "zumis", "run_zumis.sh"),
    output:
        counts = op.join(WD, "zumis", "{sample}", "work", "zUMIs_output", "expression",
                         "{sample}.dgecounts.rds"),
    params:
        zumis_dir = config.get("zumis_dir", ""),
        workdir = op.join(WD, "zumis", "{sample}", "work"),
        mem_gb = int(config.get("max_mem_mb", 48000) / 1000),
    threads:
        config.get("nthreads", 8)
    log:
        op.join(WD, "logs", "zumis_{sample}.log")
    benchmark:
        op.join(WD, "benchmarks", "zumis_{sample}.txt")
    shell:
        """
        bash {input.run} {params.zumis_dir} {params.workdir} {wildcards.sample} \
            {input.r1} {input.r2} {input.genome} {input.gtf} \
            {threads} {params.mem_gb} &> {log}
        """


rule zumis_sce:
    conda:
        op.join(PAPER_DIR, "..", "workflow", "envs", "r_bioc.yaml")
    input:
        counts = op.join(WD, "zumis", "{sample}", "work", "zUMIs_output", "expression",
                         "{sample}.dgecounts.rds"),
        script = op.join(PAPER_DIR, "zumis", "zumis_to_sce.R"),
    output:
        op.join(WD, "zumis", "{sample}", "{sample}_zumis_sce.rds")
    log:
        op.join(WD, "logs", "zumis_sce_{sample}.log")
    shell:
        "Rscript {input.script} {input.counts} {wildcards.sample} {output} &> {log}"


## OpenPipelines bd_rhapsody component on the reads of the sbg aligner, with
## its reference archive (openpipelines_reference) and bead version
## (openpipelines_bead_version: Enh for v1 and enhanced beads, EnhV2 with
## openpipelines_whitelist_dir). Needs nextflow and apptainer. Not part of
## rule all.
rule openpipelines:
    input:
        r1 = op.join(WD, "sbg", "{sample}", "fastq", "{sample}_R1.fastq.gz"),
        r2 = op.join(WD, "sbg", "{sample}", "fastq", "{sample}_R2.fastq.gz"),
        reference = config.get("openpipelines_reference",
                               op.join(WD, "sbg_reference", "rhapsody_reference.tar.gz")),
        run = op.join(PAPER_DIR, "openpipelines", "run_openpipelines.sh"),
    output:
        matrix = op.join(WD, "openpipelines", "{sample}", "work", "MEX", "matrix.mtx.gz"),
    params:
        workdir = op.join(WD, "openpipelines", "{sample}", "work"),
        mem_gb = int(config.get("max_mem_mb", 48000) / 1000),
    threads:
        config.get("nthreads", 8)
    log:
        op.join(WD, "logs", "openpipelines_{sample}.log")
    benchmark:
        op.join(WD, "benchmarks", "openpipelines_{sample}.txt")
    shell:
        """
        bash {input.run} {params.workdir} {wildcards.sample} {input.r1} {input.r2} \
            {input.reference} {threads} {params.mem_gb} &> {log}
        """


rule openpipelines_sce:
    conda:
        op.join(PAPER_DIR, "..", "workflow", "envs", "r_bioc.yaml")
    input:
        matrix = op.join(WD, "openpipelines", "{sample}", "work", "MEX", "matrix.mtx.gz"),
        script = op.join(PAPER_DIR, "..", "workflow", "src", "generate_sce_sbg.R"),
        index2barcode = op.join(PAPER_DIR, "..", "workflow", "src", "index2barcode.R"),
    output:
        op.join(WD, "openpipelines", "{sample}", "{sample}_openpipelines_sce.rds")
    params:
        mex_dir = op.join(WD, "openpipelines", "{sample}", "work", "MEX"),
        bead_version = config.get("openpipelines_bead_version", "Enh"),
        whitelist_dir = config.get("openpipelines_whitelist_dir", ""),
        features_map = op.join(WD, "starsolo", "{sample}", "Solo.out", "Gene", "filtered",
                               "features.tsv"),
    log:
        op.join(WD, "logs", "openpipelines_sce_{sample}.log")
    shell:
        """
        R -q --no-save --no-restore --slave -f {input.script} --args \
            --sample {wildcards.sample} --mex_dir {params.mex_dir} --output_fn {output} \
            --bead_version {params.bead_version} \
            --index2barcode_script {input.index2barcode} --cell_filtering native \
            $([ -n "{params.whitelist_dir}" ] && echo "--whitelist_dir {params.whitelist_dir}") \
            $([ -f "{params.features_map}" ] && echo "--features_map {params.features_map}") \
            &> {log}
        """
